# Copy this file to .env on the server. Keep actual keys out of source control.
HOST=127.0.0.1
PORT=4173
# Your actual public HTTPS origin on deployment. No trailing slash.
PUBLIC_ORIGIN=http://localhost:4173
# compatible, openai, anthropic, or gemini
AI_PROVIDER=compatible
# OpenAI-compatible API root, including /v1 where needed.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Set a model available to your provider account to enable AI.
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional for higher GitHub API quotas. Public repos work without it.
GITHUB_TOKEN=
# Optional Cloudflare Turnstile for a public deployment (set both).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Per server process/isolate. Also configure provider billing limits.
AI_DAILY_REQUEST_LIMIT=150
